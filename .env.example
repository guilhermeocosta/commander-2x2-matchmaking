# Copy to .env.local for local development. Never commit real values.

# Postgres connection string (Neon). Injected by the Neon integration on Vercel;
# for local dev, use a Neon *development branch*, never production. Used by
# /api/health (P01) and by pnpm db:migrate / db:seed (P04).
DATABASE_URL=

# Admin password for /admin. Added in P05.
ADMIN_PASSWORD=

# Random string (32+ chars) used to sign cookies. Added in P05.
SESSION_SECRET=
